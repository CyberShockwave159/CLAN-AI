<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext HTTP is intentionally permitted for all hosts: this app connects
      to user-supplied local LLM servers (llama.cpp, Ollama, LM Studio) whose LAN
      IPs are not known ahead of time. Android's network security config has no
      way to express private IP ranges/CIDR, so per-domain entries cannot cover
      arbitrary LAN addresses. HTTPS endpoints still use the system trust store.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
